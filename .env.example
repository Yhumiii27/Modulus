# Modulus — every environment variable the server reads (validated by src/server/config/parse.ts). Copy to .env.local.
# Modulus runs on PostgreSQL only. On a developer machine: `npm run db:local` creates the database, then `npm run db:migrate`.

# ── Database (required) ─────────────────────────────────────────────────────────────────────────────────────────────────
# Shared server of the Atrium suite: postgres://modulus_app:<MODULUS_APP_PASSWORD>@<host>:5432/<database> (schema `modulus`,
# created by Matrix). Host and database keep the server's current names until Matrix renames them (atrium-postgres, atrium):
# change this URL then. deploy/compose.shared.yaml builds it from ATRIUM_PG_HOST, ATRIUM_PG_DB, ATRIUM_PG_PORT (deploy/README.md).
DATABASE_URL=postgres://modulus_app:modulus-dev@127.0.0.1:5432/modulus_dev
# Connections per process (default 10).
DATABASE_POOL_MAX=
# Seed of an EMPTY schema at `npm run db:migrate`: demo (the fictitious data set of the beta) or production (the common core
# of the quotation questionnaires only; the catalogue is taken over from Keystone at delivery 2).
MODULUS_SEED=demo

# ── Sign-in (through Clavis, OpenID Connect shaped like Entra ID; Norma § 6) ──────────────────────────────────────────────
# demo (default: "View as", never exposed without HTTP authentication) | entra (sign-in through Clavis).
MODULUS_AUTH=
# ≥ 32 characters (entra): encrypts the session and sign-in cookies. `openssl rand -base64 48`.
MODULUS_SESSION_SECRET=
# Session lifetime in hours (default 12).
MODULUS_SESSION_HOURS=
# Address of Clavis (its OpenID discovery is <issuer>/.well-known/openid-configuration). ENTRA_TENANT_ID only for Entra ID itself.
ENTRA_ISSUER=
ENTRA_TENANT_ID=
# Client registered in Clavis: `npm run oidc:client -- modulus https://<modulus host>/api/auth/callback` (run in Clavis).
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
# Optional; default <origin of the redirect URI>/sign-in?signedOut=1.
ENTRA_POST_LOGOUT_REDIRECT_URI=
# on (required with entra): the roles Modulus.* are read in clavis.pub_acces at sign-in and on every request, never in the token.
MODULUS_ACCESS_FROM_CLAVIS=

# ── E-mails (notices: not sent by delivery 1) ────────────────────────────────────────────────────────────────────────────────────
# none (default: nothing is sent, the message is queued and shown) | file (one .eml per message in MODULUS_MAIL_DIR — tests and
# sandbox only). Microsoft Graph Mail.Send or SMTP: to be chosen with the IT department, not built (question D-15).
MODULUS_MAIL_TRANSPORT=
MODULUS_MAIL_DIR=
# Sender (default modulus@groupe.example).
MODULUS_MAIL_FROM=

# ── Sibling applications (public URLs, inlined at build time) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_KEYSTONE_URL=
NEXT_PUBLIC_CODEX_URL=
NEXT_PUBLIC_VIGIE_URL=
NEXT_PUBLIC_MATRIX_URL=

# ── Operations ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# Business clock: unset = the real date; "YYYY-MM-DD" pins it (demonstrations, tests).
MODULUS_CLOCK=
# Local files of this instance (default ./.data; /data in the image).
MODULUS_DATA_DIR=
# debug | info (default) | warn | error | silent ; json (production default) | pretty.
LOG_LEVEL=
LOG_FORMAT=

# ── Matrix (data catalogue) ─────────────────────────────────────────────────────────────────────────────────────────────
# Modulus declares its tables after each migration and at start-up; unset = nothing sent.
MATRIX_URL=
MATRIX_TOKEN=
# Optional: also writes the declaration to <dir>/modulus.json.
MATRIX_DECLARATIONS_DIR=

# ── Backups (npm run worker / npm run backup) ──────────────────────────────────────────────────────────────────────────
# Folder of the pg_dump backups of the schema; unset = no scheduled backup.
MODULUS_BACKUP_DIR=
# Minutes between two backups (default 1440) and days kept (default 14).
MODULUS_BACKUP_EVERY_MIN=
MODULUS_BACKUP_RETENTION_DAYS=

# ── Release and process (read by the server or deploy/start.sh, not validated) ────────────────────────────────────────────────────────────
# Version declared to Matrix with the tables (optional).
APP_VERSION=
# Port of `npm run start` (default 3800, Modulus's port in Norma's registry; tests 3810).
PORT=
# on: deploy/start.sh runs the migration, then the worker in the background, then the web server (one Coolify container).
MODULUS_SINGLE_CONTAINER=

# ── Development and tests (scripts only, never on the server) ─────────────────────────────────────────────────────────
# npm run db:local: superuser URL, database and modulus_app password it creates (defaults below).
MODULUS_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
MODULUS_LOCAL_DATABASE=modulus_dev
MODULUS_LOCAL_PASSWORD=modulus-dev
# npm test: superuser of the server where each test file creates its own database.
MODULUS_TEST_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Build output folder (CI and verification builds: .next-ci); smoke test target (npm run test:smoke).
MODULUS_DIST_DIR=
MODULUS_SMOKE_URL=http://127.0.0.1:3810
